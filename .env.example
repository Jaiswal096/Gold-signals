# MANUS MAX AI 6.0 — XAU/USD Live Signal Engine Environment Variables
# Copy to .env for local testing (`npx netlify dev`) and set in Netlify Dashboard.
# NEVER commit .env or server-side secrets to Git.

# ── Primary Market Data (Serverless Functions Only) ──────────────────────────
# Option A (Recommended): Twelve Data — https://twelvedata.com/
TWELVEDATA_API_KEY=

# Option B (Zero Broker Drift vs OANDA:XAUUSD): OANDA v20 REST API
OANDA_API_KEY=
OANDA_ENV=practice

# Option C (Optional Spot Boost): GoldAPI.io — https://www.goldapi.io/
GOLDAPI_KEY=

# ── Supabase PostgreSQL (Serverless Functions Only for Service Role) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Browser Realtime (Public Anon Key only — safe for client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── External Signal Provider Bot (Historical Bot Signals) ────────────────────
# URL returning JSON array or { signals: [...] } of past/closed bot signals
SIGNAL_BOT_URL=
SIGNAL_BOT_API_KEY=

# Optional HMAC/Bearer secret for direct webhook pushes to POST /api/bot-webhook
BOT_WEBHOOK_SECRET=
