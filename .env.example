# XAU/USD Signals Platform — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# ── GoldAPI.io ───────────────────────────────────────────────────────────────
# Server-side only (Netlify function). Get key at https://www.goldapi.io/
# Free tier: ~100 requests/hour (app polls every 60s = safe)
GOLDAPI_KEY=your_goldapi_io_key_here

# ── Supabase ─────────────────────────────────────────────────────────────────

# Public project URL — safe for browser bundles
VITE_SUPABASE_URL=https://nrdwfhllmahtakfvtruo.supabase.co

# Anon (public) key — safe for browser.
# Dashboard → Project Settings → API → anon public
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service-role key — SERVER-SIDE ONLY (used in Netlify functions only).
# Dashboard → Project Settings → API → service_role secret
# WARNING: This key bypasses Row Level Security. NEVER expose to browser.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
